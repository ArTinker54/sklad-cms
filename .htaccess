# Запасная защита, если веб-корень оказался здесь, а не в public/.
#
# Правильная установка направляет домен на public/, и тогда до этого
# файла запросы просто не доходят. Но на дешёвом хостинге веб-корень не
# всегда можно переназначить, и сайт кладут в public_html целиком. Тогда
# без этих правил из браузера читаются config/config.php с паролем от
# базы, весь исходный код и папка bin с накатчиком миграций.
#
# Это именно запасной рубеж, а не основной: скрипты в bin/ отказываются
# работать вне командной строки сами, не полагаясь на веб-сервер. На
# nginx этот файл не читается вовсе — там веб-корень обязан смотреть в
# public/, других вариантов нет.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Служебные папки наружу не отдаём ни при каком раскладе.
    RewriteRule ^(config|src|bin|data|migrations|storage|templates|docker)(/|$) - [F,L]

    # Остальное обслуживает точка входа внутри public/.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
