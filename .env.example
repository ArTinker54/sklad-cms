# =============================================================================
# Sklad CMS — Переменные окружения (.env)
# =============================================================================

# База данных MySQL 8.0+ / MariaDB 10.4+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sklad
DB_USER=root
DB_PASS=

# Основной адрес витрины (без слеша на конце)
SITE_URL=http://localhost:8000

# Тема оформления из templates/site/<theme>
SITE_THEME=default

# Контур: 'production' (открыт для поисковиков) или 'dev' (полностью закрыт noindex)
SITE_STAGE=dev

# Режим отладки: true для разработки, СТРОГО false на боевом
APP_DEBUG=true

# Почтовый шлюз (оставьте пустым для встроенной mail(), либо укажите SMTP)
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=ssl
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=СкладТех
